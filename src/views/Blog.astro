---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import { ui } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title={t('blog.title')}>
	<div class="max-w-7xl mx-auto px-4 py-16">
		<div class="text-center mb-16">
			<h1 class="text-4xl md:text-5xl font-bold mb-4 text-slate-800">{t('blog.title')}</h1>
			<p class="text-xl text-slate-600 max-w-2xl mx-auto">{t('blog.subtitle')}</p>
		</div>
		
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			<!-- Dummy blog cards -->
			{[1, 2, 3, 4, 5, 6].map((item) => (
				<article class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-lg transition-shadow cursor-pointer flex flex-col h-full">
					<div class="h-56 bg-slate-200 w-full animate-pulse flex items-center justify-center text-slate-400">
						{t('blog.card.image')}
					</div>
					<div class="p-8 flex flex-col flex-grow">
						<span class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-2">{t('blog.category')}</span>
						<h2 class="text-2xl font-bold mt-1 mb-4 text-slate-800">{t('blog.card.title')}</h2>
						<p class="text-slate-600 text-base mb-6 line-clamp-3 flex-grow">{t('blog.card.desc')}</p>
						<div class="flex items-center justify-between text-sm text-slate-500 pt-4 border-t border-slate-100">
							<span>{t('blog.card.by')}</span>
							<span>{t('blog.card.date')}</span>
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</BaseLayout>
