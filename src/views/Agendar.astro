---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';
import { ui } from '../i18n/ui';
import { WHATSAPP_NUMBER } from '../config';
import { Send, MessageCircle, CheckCircle2 } from '@lucide/astro';
import heroImage from '../assets/hero/Hero.jpg';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Lista de servicios para el dropdown
const services = [
    { id: '1', name: t('home.pricing.1.title' as any) },
    { id: '2', name: t('home.pricing.2.title' as any) },
    { id: '3', name: t('home.pricing.3.title' as any) },
    { id: '4', name: t('home.pricing.4.title' as any) },
    { id: '5', name: t('home.pricing.5.title' as any) },
];
---

<BaseLayout title={t('book.title')}>
    <div class="bg-sand/90 min-h-screen py-16 md:py-24">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-bold text-jungle-dark mb-4">
                    {t('book.title')} <span id="dynamic-service-name" class="text-jungle block md:inline mt-2 md:mt-0"></span>
                </h1>
                <p class="text-lg text-jungle-dark/70 max-w-2xl mx-auto">{t('book.subtitle')}</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
                <!-- Form Column -->
                <div class="md:col-span-3 bg-white/90 p-8 md:p-10 rounded-3xl shadow-xl shadow-jungle-dark/10 border border-sand-dark/20 relative overflow-hidden">
                    <div class="mb-8 border-b border-sand-dark/20 pb-6">
                        <h2 class="text-2xl font-bold text-jungle-dark mb-2">{t('book.form.title')}</h2>
                        <p class="text-jungle-dark/70">{t('book.form.desc')}</p>
                    </div>

                    <!-- Error Message -->
                    <div id="error-message" class="hidden bg-earth/10 border border-earth/30 text-earth-dark px-4 py-3 rounded-xl mb-6" role="alert"></div>

                    <!-- Form -->
                    <form id="booking-form" class="space-y-6">
                        <div>
                            <label for="name" class="block text-sm font-semibold text-jungle-dark mb-2">{t('book.form.name')}</label>
                            <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-xl border border-sand-dark/30 focus:ring-2 focus:ring-jungle focus:border-jungle outline-none transition-all bg-sand-light focus:bg-white text-jungle-dark" placeholder="Ej. María Pérez" />
                        </div>
                        
                        <div>
                            <label for="phone" class="block text-sm font-semibold text-jungle-dark mb-2">{t('book.form.phone')}</label>
                            <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 rounded-xl border border-sand-dark/30 focus:ring-2 focus:ring-jungle focus:border-jungle outline-none transition-all bg-sand-light focus:bg-white text-jungle-dark" placeholder="Ej. 983 123 4567" />
                        </div>

                        <div>
                            <label for="datetime" class="block text-sm font-semibold text-jungle-dark mb-2">{t('book.form.datetime')}</label>
                            <input type="datetime-local" id="datetime" name="datetime" required class="w-full px-4 py-3 rounded-xl border border-sand-dark/30 focus:ring-2 focus:ring-jungle focus:border-jungle outline-none transition-all bg-sand-light focus:bg-white text-jungle-dark" />
                        </div>

                        <div>
                            <label for="service" class="block text-sm font-semibold text-jungle-dark mb-2">{t('book.form.service')}</label>
                            <select id="service" name="service" required class="w-full px-4 py-3 rounded-xl border border-sand-dark/30 focus:ring-2 focus:ring-jungle focus:border-jungle outline-none transition-all bg-sand-light focus:bg-white text-jungle-dark">
                                <option value="" disabled selected>{t('book.form.service.default')}</option>
                                {services.map(s => (
                                    <option value={s.id}>{s.name}</option>
                                ))}
                            </select>
                        </div>

                        <button type="submit" id="submit-btn" class="w-full bg-jungle hover:bg-jungle-dark text-white font-bold py-4 px-6 rounded-xl shadow-lg shadow-jungle/20 flex items-center justify-center gap-2 transition-all transform hover:-translate-y-1">
                            <Send class="w-5 h-5" />
                            <span>{t('book.form.submit')}</span>
                        </button>
                    </form>

                    <!-- Success Message (Hidden by default) -->
                    <div id="success-message" class="hidden text-center py-10">
                        <div class="w-20 h-20 bg-jungle/10 rounded-full flex items-center justify-center mx-auto mb-6 text-jungle">
                            <CheckCircle2 class="w-12 h-12" />
                        </div>
                        <h3 class="text-3xl font-bold text-jungle-dark mb-4">{t('book.success.title')}</h3>
                        <p class="text-jungle-dark/70 text-lg">{t('book.success.desc')}</p>
                    </div>
                </div>

                <!-- WhatsApp Column -->
                <div class="md:col-span-2 bg-gradient-to-br from-jungle-light to-jungle-dark p-8 md:p-10 rounded-3xl shadow-xl shadow-jungle-dark/20 text-white sticky top-24">
                    <h2 class="text-2xl font-bold mb-4">{t('book.wa.title')}</h2>
                    <p class="text-sand/80 mb-8 leading-relaxed text-lg">
                        {t('book.wa.desc')}
                    </p>
                    
                    <a id="wa-button" href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%20Respiro%20Silvestre%2C%20quisiera%20agendar%20una%20cita.`} data-whatsapp-number={WHATSAPP_NUMBER} target="_blank" rel="noopener noreferrer" class="w-full bg-white text-jungle hover:bg-sand-light font-bold py-4 px-6 rounded-xl shadow-lg flex items-center justify-center gap-3 transition-all transform hover:-translate-y-1 text-lg text-center">
                        <MessageCircle class="w-6 h-6" />
                        {t('book.wa.btn')}
                    </a>
                    
                    <div class="mt-10 rounded-2xl overflow-hidden shadow-lg border border-jungle-light/30 bg-jungle-dark">
                        <Image src={heroImage} alt="Masaje terapéutico" class="w-full h-56 object-cover object-center opacity-80 hover:opacity-100 transition-opacity duration-500" loading="lazy" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('booking-form') as HTMLFormElement | null;
        const serviceSelect = document.getElementById('service') as HTMLSelectElement | null;
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const successMessage = document.getElementById('success-message') as HTMLDivElement | null;
        const errorMessage = document.getElementById('error-message') as HTMLDivElement | null;
        const waButton = document.getElementById('wa-button') as HTMLAnchorElement | null;
        const dynamicServiceName = document.getElementById('dynamic-service-name') as HTMLSpanElement | null;

        const params = new URLSearchParams(window.location.search);
        const serviceId = params.get('service');
        
        if (serviceId && serviceSelect) {
            const optionToSelect = Array.from(serviceSelect.options).find((opt: HTMLOptionElement) => opt.value === serviceId);
            if (optionToSelect) {
                optionToSelect.selected = true;
                updateWhatsAppLink();
            }
        }

        if (serviceSelect) {
            serviceSelect.addEventListener('change', updateWhatsAppLink);
        }

        function updateWhatsAppLink() {
            if (!serviceSelect) return;
            const selectedText = serviceSelect.options[serviceSelect.selectedIndex]?.text;
            
            if (dynamicServiceName && serviceSelect.value !== "") {
                dynamicServiceName.textContent = selectedText.toLowerCase();
            }

            if (waButton) {
                const phone = waButton.dataset.whatsappNumber || '';
                let message = "Hola Respiro Silvestre, quisiera agendar una cita.";
                if (selectedText && serviceSelect.value !== "") {
                    message = `Hola Respiro Silvestre, quisiera agendar una cita para el servicio: ${selectedText}.`;
                }
                waButton.href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
            }
        }

        if (form && submitBtn && serviceSelect) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const originalBtnText = submitBtn.innerHTML;
                submitBtn.innerHTML = 'Enviando...';
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-70');

                const formData = new FormData(form);
                const selectedServiceName = serviceSelect.options[serviceSelect.selectedIndex]?.text || '';
                
                const payload = {
                    name: String(formData.get('name') || ''),
                    phone: String(formData.get('phone') || ''),
                    datetime: String(formData.get('datetime') || ''),
                    service: String(formData.get('service') || ''),
                    serviceName: selectedServiceName,
                    source: 'Website Form',
                    lang: document.documentElement.lang || 'es',
                    submittedAt: new Date().toISOString()
                };

                try {
                    const response = await fetch('/api/booking', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });

                    const result = await response.json();

                    if (!response.ok || !result.success) {
                        throw new Error(result.error || `Error: ${response.status}`);
                    }

                    form.classList.add('hidden');
                    if (errorMessage) {
                        errorMessage.classList.add('hidden');
                    }
                    if (successMessage) {
                        successMessage.classList.remove('hidden');
                    }

                } catch (error: any) {
                    console.error('Error enviando reserva:', error);
                    if (errorMessage) {
                        errorMessage.textContent = error.message || 'Hubo un error de conexión. Por favor, intenta usar la opción de WhatsApp.';
                        errorMessage.classList.remove('hidden');
                    }
                    submitBtn.innerHTML = originalBtnText;
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('opacity-70');
                }
            });
        }
    });
</script>
