---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

let currentPath = Astro.url.pathname;
if (lang === 'en' && currentPath.startsWith('/en')) {
  currentPath = currentPath.replace('/en', '') || '/';
}
---
<header class="bg-sand/95 backdrop-blur-sm shadow-sm sticky top-0 z-50">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
		<!-- Logo -->
		<div class="text-2xl font-bold text-jungle z-20 relative">
			<a href={translatePath('/')}>Respiro Silvestre</a>
		</div>

		<!-- Desktop Navigation -->
		<div class="hidden md:flex items-center gap-6">
			<nav class="flex gap-6 items-center">
				<a href={translatePath('/')} class="text-jungle-dark/80 hover:text-jungle font-medium transition-colors">{t('nav.home')}</a>
				<a href={translatePath('/blog')} class="text-jungle-dark/80 hover:text-jungle font-medium transition-colors">{t('nav.blog')}</a>
				<a href={translatePath('/agendar')} class="bg-jungle text-white px-5 py-2 rounded-full font-medium hover:bg-jungle-dark transition-colors shadow-sm">
					{t('nav.book')}
				</a>
			</nav>
			<div class="border-l pl-6 border-sand-dark/30 flex items-center">
				<a href={translatePath(currentPath, 'es')} class={`text-sm font-bold ${lang === 'es' ? 'text-jungle' : 'text-jungle-dark/50 hover:text-jungle-dark'}`}>ES</a>
				<span class="text-sand-dark/50 mx-2">|</span>
				<a href={translatePath(currentPath, 'en')} class={`text-sm font-bold ${lang === 'en' ? 'text-jungle' : 'text-jungle-dark/50 hover:text-jungle-dark'}`}>EN</a>
			</div>
		</div>

		<!-- Mobile Menu Button -->
		<button id="mobile-menu-btn" aria-label="Abrir menú" aria-controls="mobile-menu" aria-expanded="false" class="md:hidden z-20 relative p-2 text-jungle-dark/80 hover:text-jungle focus:outline-none">
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>
	</div>

	</header>

	<!-- Mobile Navigation Menu -->
	<div id="mobile-menu" class="mobile-menu-panel" aria-hidden="true" inert>
		<nav class="flex flex-col gap-6 text-xl items-center">
			<a href={translatePath('/')} class="mobile-link text-jungle-dark hover:text-jungle font-medium">{t('nav.home')}</a>
			<a href={translatePath('/blog')} class="mobile-link text-jungle-dark hover:text-jungle font-medium">{t('nav.blog')}</a>
			<a href={translatePath('/agendar')} class="mobile-link bg-jungle text-white px-8 py-4 rounded-full font-medium shadow-sm w-full text-center mt-4">
				{t('nav.book')}
			</a>
		</nav>
		<div class="mobile-language mt-12 flex items-center justify-center gap-4">
			<a href={translatePath(currentPath, 'es')} class={`text-lg font-bold px-6 py-2 rounded-lg ${lang === 'es' ? 'bg-jungle/10 text-jungle' : 'text-jungle-dark/60 border border-sand-dark/30'}`}>ES</a>
			<a href={translatePath(currentPath, 'en')} class={`text-lg font-bold px-6 py-2 rounded-lg ${lang === 'en' ? 'bg-jungle/10 text-jungle' : 'text-jungle-dark/60 border border-sand-dark/30'}`}>EN</a>
		</div>
	</div>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');
	
	if (btn && menu) {
		const menuIcon = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>`;
		const closeIcon = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
		const setMenuOpen = (open: boolean) => {
			menu.classList.toggle('is-open', open);
			menu.setAttribute('aria-hidden', String(!open));
			menu.toggleAttribute('inert', !open);
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
			btn.innerHTML = open ? closeIcon : menuIcon;
			document.body.style.overflow = open ? 'hidden' : '';
			if (open) menu.querySelector<HTMLElement>('a[href]')?.focus();
			else btn.focus();
		};
		btn.addEventListener('click', () => setMenuOpen(btn.getAttribute('aria-expanded') !== 'true'));

		const links = menu.querySelectorAll('a[href]');
		links.forEach(link => {
			link.addEventListener('click', () => {
				setMenuOpen(false);
			});
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.classList.contains('is-open')) setMenuOpen(false);
		});
	}
</script>

<style>
	.mobile-menu-panel { position: fixed; inset: 4rem 0 0; z-index: 60; box-sizing: border-box; width: 100vw; height: calc(100dvh - 4rem); overflow-y: auto; padding: 3rem 1.5rem calc(2rem + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; background: rgba(229, 211, 179, .98); box-shadow: 0 20px 40px rgba(29, 58, 23, .18); transform: translateX(100%); visibility: hidden; transition: transform .28s ease, visibility .28s ease; }
	.mobile-menu-panel.is-open { transform: translateX(0); visibility: visible; }
	.mobile-menu-panel nav { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; width: 100%; font-size: 1.2rem; }
	.mobile-menu-panel nav a { width: 100%; text-align: center; }
	.mobile-menu-panel .mobile-language { display: flex; justify-content: center; gap: 1rem; margin-top: 2rem; }
	@media (min-width: 768px) { .mobile-menu-panel { display: none; } }
	@media (prefers-reduced-motion: reduce) { .mobile-menu-panel { transition: none; } }
</style>
