---
import { useTranslations } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';

interface Props { lang: keyof typeof ui; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="py-20 px-4 bg-white">
	<div class="max-w-3xl mx-auto" id="faq-content">
		<h2 class="text-3xl md:text-4xl font-bold text-center text-slate-800 mb-12">{t('home.faq.title')}</h2>
		<div class="space-y-6">
			<div class="border-b border-slate-200 pb-6">
				<h3 class="text-xl font-bold text-slate-800 mb-3">{t('home.faq.1.q')}</h3>
				<p class="text-slate-600">{t('home.faq.1.a')}</p>
			</div>
			<div class="border-b border-slate-200 pb-6">
				<h3 class="text-xl font-bold text-slate-800 mb-3">{t('home.faq.2.q')}</h3>
				<p class="text-slate-600">{t('home.faq.2.a')}</p>
			</div>
			<div class="border-b border-slate-200 pb-6">
				<h3 class="text-xl font-bold text-slate-800 mb-3">{t('home.faq.3.q')}</h3>
				<p class="text-slate-600">{t('home.faq.3.a')}</p>
			</div>
		</div>
	</div>
</section>
<script>
	import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

	gsap.from("#faq-content", { 
        scrollTrigger: {
            trigger: "#faq-content",
            start: "top 80%",
        },
        opacity: 0, 
        y: 30, 
        duration: 1, 
        ease: "power3.out" 
    });
</script>
