---
import { Image } from 'astro:assets';
import { useTranslations } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';
import { MapPin } from '@lucide/astro';
import heroImage from '../../assets/hero/Hero.jpg';

interface Props { lang: keyof typeof ui; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="relative h-[100svh] min-h-[600px] flex items-start overflow-hidden pt-35 lg:pt-30">
	<!-- Background Image -->
	<div class="absolute inset-0 z-0 bg-jungle-dark">
		<Image src={heroImage} alt={t('home.hero.image_alt')} class="w-full h-full object-cover object-center opacity-80" loading="eager" />
		
		<!-- Overlay Desktop: Left to Right -->
		<div class="hidden md:block absolute inset-0 bg-gradient-to-r from-jungle-dark/95 via-jungle-dark/70 to-transparent"></div>
		
		<!-- Overlay Mobile: Bottom to Top + Darker overall for readability -->
		<div class="md:hidden absolute inset-0 bg-gradient-to-t from-jungle-dark/95 via-jungle-dark/60 to-jungle-dark/30"></div>
	</div>

	<!-- Content -->
	<div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10">
		<div class="max-w-2xl text-center md:text-left mx-auto md:mx-0" id="hero-content">
			<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-sand-light mb-8 hero-anim">
				<MapPin class="w-4 h-4 text-earth-light" />
				<span class="text-sm font-medium tracking-wide">{t('home.hero.location')}</span>
			</div>
			
			<h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold text-white leading-tight mb-6 tracking-tight drop-shadow-lg hero-anim">
				{t('home.hero.title')}
			</h1>
			
			<p class="text-lg sm:text-xl text-sand/80 mb-10 max-w-lg mx-auto md:mx-0 drop-shadow hero-anim">
				{t('home.hero.subtitle')}
			</p>
			
			<div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start hero-anim">
				<a href={lang === 'es' ? '/agendar' : '/en/agendar'} class="w-full sm:w-auto bg-jungle hover:bg-jungle-light text-white text-lg font-bold py-4 px-10 rounded-full shadow-xl shadow-jungle-dark/50 transition-all transform hover:-translate-y-1 hover:shadow-2xl text-center">
					{t('home.hero.cta')}
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from "gsap";
	
	// Cinematic staggered entrance
	gsap.from(".hero-anim", { 
		opacity: 0, 
		y: 40, 
		duration: 1.2, 
		stagger: 0.2, 
		ease: "power4.out", 
		delay: 0.2 
	});
	
	// Subtle zoom on the background image for a premium feel
	gsap.from("section img", {
		scale: 1.05,
		duration: 2,
		ease: "power2.out"
	});
</script>
