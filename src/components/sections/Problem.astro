---
import { Image } from 'astro:assets';
import { useTranslations } from '../../i18n/utils';
import type { ui } from '../../i18n/ui';
import { Leaf } from '@lucide/astro';
import problem1 from '../../assets/Problem/M1.jpg';
import problem2 from '../../assets/Problem/M2.jpg';
import problem3 from '../../assets/Problem/M3.jpg';

interface Props { lang: keyof typeof ui; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="py-20 md:py-20 px-6 sm:px-10 bg-sand/90">
	<div class="max-w-7xl mx-auto" id="problem-content">
		<div class="text-center mb-16">
			<h2 class="text-3xl md:text-4xl font-bold text-jungle-dark mb-4">{t('home.problem.title')}</h2>
			<div class="w-24 h-1 bg-earth mx-auto rounded-full"></div>
		</div>
		
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
			<!-- Problem 1 -->
			<div class="problem-card-wrapper flex">
				<div class="w-full problem-card bg-white/80 rounded-3xl border border-sand-dark/30 hover:border-earth/40 transition-all overflow-hidden flex flex-col group">
					<div class="w-full h-56 relative overflow-hidden bg-sand-dark/20 flex items-center justify-center">
						<Image src={problem1} alt={t('home.problem.q1')} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 z-10" loading="lazy" />
						<div class="absolute top-4 right-4 w-12 h-12 bg-white/90 backdrop-blur-sm rounded-2xl flex items-center justify-center shadow-sm z-20">
							<Leaf class="w-6 h-6 text-earth" />
						</div>
					</div>
					<div class="p-6 flex-grow flex flex-col justify-center text-center">
						<p class="text-lg text-jungle-dark font-semibold leading-relaxed">{t('home.problem.q1')}</p>
					</div>
				</div>
			</div>

			<!-- Problem 2 -->
			<div class="problem-card-wrapper flex">
				<div class="w-full problem-card bg-white/80 rounded-3xl border border-sand-dark/30 hover:border-earth/40 transition-all overflow-hidden flex flex-col group">
					<div class="w-full h-56 relative overflow-hidden bg-sand-dark/20 flex items-center justify-center">
						<Image src={problem2} alt={t('home.problem.q2')} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 z-10" loading="lazy" />
						<div class="absolute top-4 right-4 w-12 h-12 bg-white/90 backdrop-blur-sm rounded-2xl flex items-center justify-center shadow-sm z-20">
							<Leaf class="w-6 h-6 text-earth" />
						</div>
					</div>
					<div class="p-6 flex-grow flex flex-col justify-center text-center">
						<p class="text-lg text-jungle-dark font-semibold leading-relaxed">{t('home.problem.q2')}</p>
					</div>
				</div>
			</div>

			<!-- Problem 3 -->
			<div class="problem-card-wrapper flex">
				<div class="w-full problem-card bg-white/80 rounded-3xl border border-sand-dark/30 hover:border-earth/40 transition-all overflow-hidden flex flex-col group">
					<div class="w-full h-56 relative overflow-hidden bg-sand-dark/20 flex items-center justify-center">
						<Image src={problem3} alt={t('home.problem.q3')} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110 z-10" loading="lazy" />
						<div class="absolute top-4 right-4 w-12 h-12 bg-white/90 backdrop-blur-sm rounded-2xl flex items-center justify-center shadow-sm z-20">
							<Leaf class="w-6 h-6 text-earth" />
						</div>
					</div>
					<div class="p-6 flex-grow flex flex-col justify-center text-center">
						<p class="text-lg text-jungle-dark font-semibold leading-relaxed">{t('home.problem.q3')}</p>
					</div>
				</div>
			</div>
		</div>

		<!-- Mensaje empático -->
		<div class="bg-jungle/10 border border-jungle/20 p-6 md:p-8 rounded-3xl text-center max-w-5xl mx-auto shadow-sm" id="problem-message">
			<p class="text-lg text-jungle-dark font-medium italic leading-relaxed">
				"{t('home.problem.desc')}"
			</p>
		</div>
	</div>
</section>
<script>
	import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

	// Animar título y línea
	gsap.from("#problem-content h2, #problem-content .w-24", {
		scrollTrigger: {
            trigger: "#problem-content",
            start: "top 80%",
        },
        opacity: 0, 
        y: 20, 
        duration: 0.8,
		stagger: 0.1,
        ease: "power3.out"
	});

	// Animar tarjetas individualmente
	gsap.from(".problem-card-wrapper", { 
        scrollTrigger: {
            trigger: ".problem-card-wrapper",
            start: "top 85%",
        },
        opacity: 0, 
        y: 40, 
        duration: 0.8, 
		stagger: 0.2,
        ease: "power3.out",
		clearProps: "all"
    });

	// Animar el mensaje final
	gsap.from("#problem-message", { 
        scrollTrigger: {
            trigger: "#problem-message",
            start: "top 90%",
        },
        opacity: 0, 
        scale: 0.95,
        duration: 0.8, 
        ease: "power3.out" 
    });
</script>
