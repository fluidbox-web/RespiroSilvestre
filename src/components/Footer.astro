---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<footer class="bg-slate-900 text-slate-300 py-12">
	<div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
		<div>
			<h3 class="text-xl font-bold text-white mb-4">Hilda Romero</h3>
			<p class="text-slate-400">{t('footer.subtitle')}</p>
		</div>
		<div>
			<h4 class="text-lg font-semibold text-white mb-4">{t('footer.quickLinks')}</h4>
			<ul class="space-y-2">
				<li><a href={translatePath('/')} class="hover:text-teal-400 transition-colors">{t('nav.home')}</a></li>
				<li><a href={translatePath('/blog')} class="hover:text-teal-400 transition-colors">{t('nav.blog')}</a></li>
				<li><a href={translatePath('/agendar')} class="hover:text-teal-400 transition-colors">{t('nav.book')}</a></li>
			</ul>
		</div>
		<div>
			<h4 class="text-lg font-semibold text-white mb-4">{t('footer.contact')}</h4>
			<p class="text-slate-400">info@hildaromero.com</p>
			<p class="text-slate-400">+52 123 456 7890</p>
		</div>
	</div>
	<div class="mt-12 pt-8 border-t border-slate-800 text-center text-slate-500 text-sm">
		<p>&copy; {new Date().getFullYear()} Hilda Romero Masajes. {t('footer.rights')}</p>
	</div>
</footer>
